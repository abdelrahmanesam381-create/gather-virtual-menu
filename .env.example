DATABASE_URL="postgresql://menu:menu_local_only@localhost:5432/virtual_menu?schema=public"
# For Supabase, use the dashboard's session pooler URL (port 5432), with
# your server-only database role/password and sslmode=require. Never use NEXT_PUBLIC_.
# For Supabase, use the dashboard's session pooler URL (port 5432), with
# your server-only database role/password and sslmode=require. Never use NEXT_PUBLIC_.
APP_URL="http://localhost:3000"
UPLOAD_DIR="./var/uploads"
SNAPSHOT_DIR="./var/snapshots"
# SMTP is optional locally: invitation messages are written to var/mail.
# Production requires SMTP and a durable shared upload/snapshot volume.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Gather <menus@example.com>"
# Optional sample data. Supply a password when seeding (never a production account).
SEED_EMAIL="demo@example.com"
SEED_PASSWORD=""
